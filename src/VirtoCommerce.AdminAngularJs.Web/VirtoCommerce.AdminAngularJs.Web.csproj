<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SonarQubeTestProject>false</SonarQubeTestProject>
    <NoWarn>1591;NU1608</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="node_modules\**" />
    <Content Remove="node_modules\**" />
    <EmbeddedResource Remove="node_modules\**" />
    <None Remove="node_modules\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- The admin SPA (sources, styles, images and the webpack output in Content\wwwroot\dist) ships as module content, not as part of the assembly -->
    <Content Update="Content\**">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Update="Localizations\**">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Update="package.json;npm-shrinkwrap.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!-- The AngularJS admin moved verbatim from vc-platform (src/VirtoCommerce.Platform.Web/wwwroot), where it was existing
         code; here every file is new to the repository, so code analysis would count the whole legacy SPA as new code.
         Keep it out of analysis; the module's own C# and tests are analyzed. -->
    <None Update="Content\wwwroot\**" SonarQubeExclude="true" />
    <Content Update="Content\wwwroot\**" SonarQubeExclude="true" />
    <SonarQubeSetting Include="sonar.exclusions">
      <Value>**/Content/wwwroot/**</Value>
    </SonarQubeSetting>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="VirtoCommerce.Platform.Core" Version="3.1092.0" />
  </ItemGroup>
</Project>
